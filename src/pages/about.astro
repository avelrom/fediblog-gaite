---
import { isOff } from '@fediblog/core/lib/flags';
import Base from '../layouts/Base.astro';
import ProfileCard from '@fediblog/core/components/ProfileCard.astro';
import { SITE } from '../config';
import { actor, formatCount } from '../lib/actor';

if (isOff(SITE.profile?.show)) return Astro.redirect(import.meta.env.BASE_URL);
---

<Base title="Acerca de" description={`Sobre ${SITE.site.title} y ${actor.handle}.`}>
  <section class="about">
    <ProfileCard actor={actor} formatCount={formatCount} profile={SITE.profile} social={SITE.social} />
  </section>
</Base>

<style>
  .about { --ab-radius: 6px; }
</style>
